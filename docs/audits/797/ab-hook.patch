+/// Measurement only (#797, `--cfg minigraf_ab`): an in-memory database whose
+/// facts were checkpointed into a memory backend, so queries read a populated
+/// committed reader (`Minigraf::in_memory` keeps every fact pending).
+#[cfg(minigraf_ab)]
+#[doc(hidden)]
+pub struct AbCommittedMemory {
+    pub db: Minigraf,
+    pfs: PersistentFactStorage<MemoryBackend>,
+}
+
+#[cfg(minigraf_ab)]
+impl AbCommittedMemory {
+    /// Run `commands` (transactions) and checkpoint them into the backend.
+    pub fn new(commands: &[String]) -> Result<Self, MinigrafError> {
+        (|| -> Result<Self> {
+            let mut pfs = PersistentFactStorage::new(MemoryBackend::new(), 256)?;
+            let db = Minigraf::from_parts(
+                pfs.storage().clone(),
+                WriteContext::Memory,
+                OpenOptions::default(),
+            );
+            for c in commands {
+                db.execute(c)?;
+            }
+            pfs.mark_dirty();
+            pfs.save()?;
+            Ok(AbCommittedMemory { db, pfs })
+        })()
+        .map_err(MinigrafError::from)
+    }
+
+    /// Build and drop `n` committed readers of the checkpointed generation.
+    pub fn construct_readers(&self, n: usize) {
+        for _ in 0..n {
+            std::hint::black_box(self.pfs.ab_reader());
+        }
+    }
+}
+
+#[cfg(all(minigraf_ab, not(target_arch = "wasm32")))]
+impl Minigraf {
+    /// Measurement only (#797): build and drop `n` committed readers of a
+    /// file database's active meta, as an open or checkpoint builds one.
+    #[doc(hidden)]
+    pub fn ab_construct_readers(&self, n: usize) -> Result<(), MinigrafError> {
+        let ctx = self
+            .inner
+            .write_lock
+            .lock()
+            .map_err(|_| MinigrafError::from(err_coded!(ErrorCode::Api001)))?;
+        let pfs = match &*ctx {
+            WriteContext::File { pfs, .. } | WriteContext::ReadOnly { pfs } => pfs,
+            WriteContext::Memory => return Ok(()),
+        };
+        for _ in 0..n {
+            std::hint::black_box(pfs.ab_reader());
+        }
+        Ok(())
+    }
+}
